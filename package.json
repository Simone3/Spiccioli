{
	"name": "spiccioli",
	"productName": "Spiccioli",
	"version": "0.1.0",
	"description": "A private ledger for one person",
	"main": "dist/electron/main.js",
	"scripts": {
		"build": "npm run build-react && npm run build-electron",
		"build-react": "vite build",
		"build-electron": "node scripts/build-electron.js",
		"build-icons": "electron scripts/build-icons.js",
		"start": "node scripts/dev.js",
		"start-packaged": "npm run build && electron-forge start",
		"test": "vitest run",
		"prepackage": "npm run build",
		"package": "electron-forge package",
		"premake": "npm run build",
		"make": "electron-forge make",
		"lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"tests/**/*.ts\" \"tests/**/*.tsx\"",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Simone3/Spiccioli.git"
	},
	"keywords": [
		"Spiccioli",
		"Ledger",
		"Finances",
		"Accounts",
		"Transactions",
		"Investments"
	],
	"author": "Simone Graziussi",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/Simone3/Spiccioli/issues"
	},
	"dependencies": {
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@fontsource/inter": "5.3.0",
		"electron-log": "5.4.4",
		"electron-squirrel-startup": "1.0.1",
		"react": "19.2.8",
		"react-datepicker": "9.1.0",
		"react-dom": "19.2.8",
		"react-router": "8.3.0"
	},
	"devDependencies": {
		"@electron-forge/cli": "7.11.2",
		"@electron-forge/maker-deb": "7.11.2",
		"@electron-forge/maker-rpm": "7.11.2",
		"@electron-forge/maker-squirrel": "7.11.2",
		"@electron-forge/maker-zip": "7.11.2",
		"@electron-forge/plugin-auto-unpack-natives": "7.11.2",
		"@electron-forge/plugin-fuses": "7.11.2",
		"@electron/fuses": "1.8.0",
		"@eslint/js": "9.39.4",
		"@stylistic/eslint-plugin": "5.10.0",
		"@testing-library/jest-dom": "7.0.0",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.3",
		"@types/node": "24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@typescript-eslint/eslint-plugin": "8.66.0",
		"@typescript-eslint/parser": "8.66.0",
		"@vitejs/plugin-react": "6.0.5",
		"@vitest/eslint-plugin": "1.6.26",
		"electron": "43.3.0",
		"esbuild": "0.28.1",
		"eslint": "9.39.4",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsdoc": "63.3.3",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "17.9.0",
		"jsdom": "30.0.1",
		"typescript": "5.9.3",
		"vite": "8.2.0",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=24"
	}
}
